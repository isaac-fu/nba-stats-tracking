    "/api/v1/players": {
      "get": {
        "operationId": "listPlayers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerList"
                }
              }
            }
          },
          "405": {
            "description": "Only GET is accepted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No published release, or statistics are temporarily unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Statistics"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "season",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1947,
              "maximum": 2200
            },
            "description": "Season ending year: 2024 means 2023\u201324."
          },
          {
            "in": "query",
            "name": "phase",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "playoffs"
              ],
              "default": "regular"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": ""
            },
            "description": "Literal case-insensitive name search; teams also search abbreviations."
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pts_per_game",
                "pts",
                "reb_per_game",
                "ast_per_game",
                "ts_pct",
                "games_played",
                "name"
              ],
              "default": "pts_per_game"
            },
            "description": "Metrics descending, NULL last; name ascending; ID breaks ties."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ]
      }
    },
    "/api/v1/comparisons/players": {
