          "503": {
            "description": "No published release, or statistics are temporarily unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "At least one requested entity has no statistics in the season/phase",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "tags": [
          "Statistics"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "season",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1947,
              "maximum": 2200
            },
            "description": "Season ending year: 2024 means 2023\u201324."
          },
          {
            "in": "query",
            "name": "phase",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "playoffs"
              ],
              "default": "regular"
            }
          },
          {
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 504
            },
            "description": "2\u20135 unique comma-separated entity IDs. Response rows preserve this order. Spaces are rejected."
          }
        ]
      }
    },
